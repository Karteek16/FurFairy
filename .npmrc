# The dev-only PGlite tooling (pglite-prisma-adapter, @prisma/adapter-pg) declares
# a peer dependency on @prisma/client >= 7, while the app runs on @prisma/client 5.
# These adapters are used ONLY by local scripts (scripts/dev-postgres.ts, e2e.ts),
# never by the app or the Netlify function (which use Supabase Postgres directly).
# Allow npm to install despite the peer mismatch so CI/Netlify installs succeed.
legacy-peer-deps=true
