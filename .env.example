# ---- FurFairy environment configuration ----
# Copy to .env for local dev. In production these are set in the Netlify UI
# (Site settings -> Environment variables). NEVER commit real secrets.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ── Database (Supabase Postgres) ──
# Runtime connection: use the Supabase "Transaction pooler" string (port 6543).
# It MUST include ?pgbouncer=true for serverless Prisma.
#   Supabase Dashboard -> Project Settings -> Database -> Connection string -> Transaction pooler
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations only: use the Supabase "Direct connection" string (port 5432).
# Prisma CLI (migrate/db push) uses this; the running app does not.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# For purely local Postgres instead of Supabase, both can point at localhost:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/furfairy?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/furfairy?schema=public"

# ── Auth secrets (use long random strings in production) ──
JWT_ACCESS_SECRET="dev-access-secret-change-me-please-32chars-min"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-please-32chars-min"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ── Platform bootstrap super-admin (used by seed only) ──
PLATFORM_ADMIN_EMAIL="admin@furfairy.in"
PLATFORM_ADMIN_PASSWORD="ChangeMe!123"

# ── CORS ──
# Comma-separated browser origins allowed to call the API in production.
# Not needed in development (any origin is reflected).
CORS_ORIGINS="https://furfairy.in,https://www.furfairy.in"

# Integration mode: sandbox | live  (live requires explicit approval)
INTEGRATION_MODE=sandbox

# Rate limiting
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW="1 minute"

# ── Frontend (web/) ──
# In production Netlify sets this to /api/v1 (same-origin). For local dev the
# Vite proxy handles /api, so you normally don't set this locally.
# VITE_API_BASE="/api/v1"
